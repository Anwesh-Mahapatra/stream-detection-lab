# Copy this to docker/.env (bootstrap.sh does this for you). Real .env is gitignored
# because heap sizes are machine-specific tuning, not project config.

# ---- image versions, pinned on purpose ----
# See README "known trade-offs" for why these exact versions were picked.
KAFKA_IMAGE_TAG=3.7.0
FLINK_IMAGE_TAG=1.18.1-scala_2.12-java11
# Bare version string (no tag suffix) - used by docker/flink/Dockerfile to pip install
# the matching PyFlink release and to pick the right connector jar.
FLINK_VERSION=1.18.1
ELASTIC_VERSION=9.5.1

# ---- Kafka ----
# Generated fresh by scripts/bootstrap.sh on first run (kafka-storage.sh random-uuid
# equivalent). Every broker in a KRaft cluster must share this ID - it's baked into
# the on-disk log at first boot and can't be changed without wiping the volume.
KAFKA_CLUSTER_ID=CHANGE_ME_RUN_BOOTSTRAP_SH
KAFKA_HEAP_OPTS=-Xmx1G -Xms1G
KAFKA_LOG_RETENTION_HOURS=168

# ---- Flink ----
# jobmanager.memory.process.size / taskmanager.memory.process.size - this is TOTAL
# container memory (heap + off-heap + network buffers + JVM metaspace), not just heap.
# Flink carves up the split internally; see README RAM budget for the breakdown.
FLINK_JM_PROCESS_SIZE=1024m
FLINK_TM_PROCESS_SIZE=1536m
FLINK_TM_NUM_SLOTS=2

# ---- Elasticsearch ----
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ---- Kibana ----
KIBANA_MAX_OLD_SPACE_MB=1024
# Host address Kibana's 5601 is published on. Keep 127.0.0.1 unless you accept the
# trade-off: there is no auth in this stack, so any other value exposes Kibana (and
# through it, all ES data) to that network unauthenticated. A ufw rule does NOT
# restrict a Docker-published port - Docker's iptables rules bypass ufw entirely.
KIBANA_BIND=127.0.0.1

# Kibana refuses to run Alerting/Actions without a stable Encrypted Saved Objects
# key - the symptom is a 500 in the UI: "Unable to create actions client because the
# Encrypted Saved Objects plugin is missing encryption key". Generate three distinct
# 32-char values (bootstrap.sh does this for you):
#   tr -dc 'a-f0-9' </dev/urandom | head -c 32
# Keep them STABLE. Rotating a key makes everything already encrypted with the old
# one (connector secrets, alert rule credentials) permanently unreadable.
KIBANA_ESO_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING_
KIBANA_REPORTING_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING_
KIBANA_SECURITY_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING_

# ---- Elasticsearch security ----
# xpack.security.enabled is TRUE. Kibana's detection engine calls
# /_security/user/_has_privileges, which simply has no handler when security is off -
# the symptom is "Failed to retrieve detection engine privileges / undefined:
# undefined (400)". bootstrap.sh generates these; note there is no TLS, so this is
# authentication without encryption - fine on a private lab, not on a real network.
#
# ELASTIC_PASSWORD is only consumed while the .security index is bootstrapped on the
# first start with security enabled. Later edits do nothing - rotate via the API:
#   curl -XPOST -u elastic:<old> $ES/_security/user/elastic/_password -d '{"password":"..."}'
ELASTIC_PASSWORD=CHANGE_ME_RUN_BOOTSTRAP_SH
# Built-in least-privilege account Kibana authenticates as. Must be set through the
# _security API after ES boots - bootstrap.sh does this. Never use elastic here.
KIBANA_SYSTEM_PASSWORD=CHANGE_ME_RUN_BOOTSTRAP_SH

# ---- Fluent Bit -> Elasticsearch ----
# Least-privilege ingest account (role k8s_audit_writer: write to k8s-audit* only).
# Fluent Bit does NOT read this file - export these into its environment first:
#   export ES_USER=$FLUENTBIT_ES_USER ES_PASSWORD=$FLUENTBIT_ES_PASSWORD
FLUENTBIT_ES_USER=fluentbit_writer
FLUENTBIT_ES_PASSWORD=CHANGE_ME_RUN_BOOTSTRAP_SH
