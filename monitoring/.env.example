# Copy this to monitoring/.env. The real .env is gitignored - it holds a Grafana
# password and a machine-specific bind address, neither of which belongs in git.

# Host address Prometheus (9090) and Grafana (3000) publish on.
# Keep 127.0.0.1 unless you accept the trade-off. Prometheus has NO authentication
# of any kind, and a ufw rule will NOT restrict a Docker-published port (Docker's
# iptables rules bypass ufw) - see README "known trade-offs".
MONITORING_BIND=127.0.0.1

# Grafana admin login. Change the password before binding Grafana off localhost.
# Only read on FIRST start - once the grafana-data volume exists, the password lives
# there. To rotate afterwards:
#   docker exec sdl-grafana grafana-cli admin reset-admin-password <new-password>
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
